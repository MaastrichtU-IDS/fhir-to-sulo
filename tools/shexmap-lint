#!/usr/bin/env python3
"""shexmap-lint -- static analysis for a ShExMap source/target pair.

The pinned engine ships no static checker (DR-301 probe 7) and its response to
a bad pair is to delete the offending shape and exit 0. CD-1 moves the
acceptance matrix's "Mapping analysis" row here. This command **fails the
build**: any error finding exits non-zero, and there is no flag to downgrade
one, because every error corresponds to something the engine will not tell you
about at runtime.

    shexmap-lint SOURCE.shex TARGET.shex
    shexmap-lint --dir maps/            # every <case>/{source,target}.shex
    shexmap-lint SOURCE.shex TARGET.shex --static 'http://ex/v#unit=mm[Hg]'
    shexmap-lint --dir maps/ --json

Exit status
    0  no errors (warnings may be present)
    1  at least one error finding
    2  could not run: bad arguments, unreadable file, or no engine
"""

from __future__ import annotations

import argparse
import json
import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(ROOT, "src"))

from fhir_sulo.engine.docker import EngineImage, EngineUnavailable  # noqa: E402
from fhir_sulo.engine.linter import Severity, lint_pair  # noqa: E402
from fhir_sulo.engine.shexj import Schema  # noqa: E402

SOURCE_BASE = "urn:fhir-sulo:test-source"
TARGET_BASE = "urn:fhir-sulo:test-target"

GREEN, RED, YELLOW, DIM, OFF = "\033[32m", "\033[31m", "\033[33m", "\033[2m", "\033[0m"


def colour(text: str, code: str) -> str:
    return text if not sys.stdout.isatty() else f"{code}{text}{OFF}"


def parse_schema(engine: EngineImage, path: str, base: str, label: str) -> Schema:
    with open(path, encoding="utf-8") as handle:
        shexc = handle.read()
    response = engine.parse_schema(shexc, base)
    if not response.get("ok"):
        where = ""
        if response.get("line"):
            where = f" at line {response['line']}"
        raise SystemExit(
            f"{colour('ERROR', RED)} {label}: {path} does not parse{where}: "
            f"{response.get('error')}"
        )
    return Schema(raw=response["schema"], prefixes=response["prefixes"], label=label)


def pairs_in(directory: str):
    """Every ``<dir>/**/source.shex`` with a ``target.shex`` beside it.

    Recursive, because map pairs are grouped by FHIR release
    (``maps/r4/<name>/``) and a one-level scan would silently lint nothing --
    which for a build gate is the worst possible failure mode.
    """
    for dirpath, dirnames, filenames in os.walk(directory):
        dirnames.sort()
        if "source.shex" in filenames and "target.shex" in filenames:
            name = os.path.relpath(dirpath, directory)
            yield (name if name != "." else os.path.basename(os.path.abspath(directory)),
                   os.path.join(dirpath, "source.shex"),
                   os.path.join(dirpath, "target.shex"))


def statics(values):
    out = {}
    for item in values or ():
        if "=" not in item:
            raise SystemExit(f"--static expects NAME=VALUE, got {item!r}")
        name, _, value = item.partition("=")
        out[name] = value
    return out


def main() -> int:
    ap = argparse.ArgumentParser(
        prog="shexmap-lint", description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("source", nargs="?", help="source ShExC schema")
    ap.add_argument("target", nargs="?", help="target ShExC schema")
    ap.add_argument("--dir", help="lint every <case>/{source,target}.shex below here")
    ap.add_argument("--static", action="append", metavar="NAME=VALUE",
                    help="a staticVar the driver will supply; counts as bound")
    ap.add_argument("--json", action="store_true", help="machine-readable output")
    ap.add_argument("--image", help="override the pinned engine image tag")
    ap.add_argument("--require-pairs", action="store_true",
                    help="exit 2 if --dir contains no schema pair at all; for a "
                         "build gate, linting nothing must not read as passing")
    ap.add_argument("--source-shape", help="lint from this source shape, not start")
    ap.add_argument("--target-shape", help="lint from this target shape, not start")
    args = ap.parse_args()

    if bool(args.dir) == bool(args.source and args.target):
        ap.error("give either SOURCE and TARGET, or --dir")

    engine = EngineImage(tag=args.image) if args.image else EngineImage()
    try:
        engine.ensure_built()
    except EngineUnavailable as exc:
        print(f"{colour('ERROR', RED)} engine unavailable: {exc}", file=sys.stderr)
        print("  the linter parses with the pinned engine's own parser, so that it "
              "cannot disagree with the engine about what a schema says",
              file=sys.stderr)
        return 2

    if args.dir:
        if not os.path.isdir(args.dir):
            print(f"{colour('ERROR', RED)} no such directory: {args.dir}", file=sys.stderr)
            return 2
        work = list(pairs_in(args.dir))
        if not work:
            print(f"no schema pairs under {args.dir}", file=sys.stderr)
            if args.require_pairs:
                print("  --require-pairs was given: a gate that lints nothing is "
                      "not a gate. Check the directory and the source.shex / "
                      "target.shex filenames.", file=sys.stderr)
                return 2
            return 0
    else:
        work = [(os.path.basename(os.path.dirname(os.path.abspath(args.source))) or "pair",
                 args.source, args.target)]

    reports, failed = [], 0
    for name, source_path, target_path in work:
        source = parse_schema(engine, source_path, SOURCE_BASE, f"{name}/source")
        target = parse_schema(engine, target_path, TARGET_BASE, f"{name}/target")
        report = lint_pair(source, target, static_variables=statics(args.static),
                           source_start=args.source_shape,
                           target_start=args.target_shape)
        reports.append((name, source_path, target_path, report))
        if not report.ok:
            failed += 1

    if args.json:
        print(json.dumps({
            "ok": failed == 0,
            "pairs": [
                {
                    "name": name, "source": source_path, "target": target_path,
                    "ok": report.ok,
                    "maxRepetitionDepth": report.max_repetition_depth,
                    "findings": [
                        {"code": f.code, "severity": f.severity.value,
                         "schema": f.schema, "where": f.where, "message": f.message}
                        for f in report.findings
                    ],
                }
                for name, source_path, target_path, report in reports
            ],
        }, indent=1))
        return 1 if failed else 0

    for name, source_path, target_path, report in reports:
        status = colour("PASS", GREEN) if report.ok else colour("FAIL", RED)
        print(f"{status} {name}  {colour(source_path + ' -> ' + target_path, DIM)}")
        for finding in report.findings:
            mark = colour("error", RED) if finding.severity is Severity.ERROR \
                else colour("warning", YELLOW)
            where = f" [{finding.where}]" if finding.where else ""
            print(f"    {mark} {finding.code} ({finding.schema}){where}")
            print(f"        {finding.message}")

    total = len(reports)
    if failed:
        print(f"\n{colour('FAILED', RED)}: {failed} of {total} pair(s) carry errors. "
              f"Each one is a runtime failure the engine would not report.")
        return 1
    warnings = sum(len(r.warnings) for _, _, _, r in reports)
    suffix = f" ({warnings} warning(s))" if warnings else ""
    print(f"\n{colour('OK', GREEN)}: {total} pair(s) clean{suffix}.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
