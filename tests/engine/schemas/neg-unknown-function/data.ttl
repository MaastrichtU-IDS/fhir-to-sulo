# One blood-pressure Observation with two components. The acceptance tuple this
# must preserve is {(systolic,120,mm[Hg]), (diastolic,80,mm[Hg])}; a cross-join
# would produce (systolic,80,...) from exactly these triples.
PREFIX fhir: <http://hl7.org/fhir/>
PREFIX sct:  <http://snomed.info/id/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>

<https://fhir.example/Observation/bp-1>
    fhir:status    "final" ;
    fhir:subject   <https://fhir.example/Patient/p-1> ;
    fhir:effective "2026-03-04T09:15:00Z"^^xsd:dateTime ;
    fhir:component <https://fhir.example/Observation/bp-1#c0> ,
                   <https://fhir.example/Observation/bp-1#c1> .

<https://fhir.example/Observation/bp-1#c0>
    fhir:code  sct:271649006 ;
    fhir:value "120"^^xsd:decimal ;
    fhir:unit  "mm[Hg]" .

<https://fhir.example/Observation/bp-1#c1>
    fhir:code  sct:271650006 ;
    fhir:value "80"^^xsd:decimal ;
    fhir:unit  "mm[Hg]" .
