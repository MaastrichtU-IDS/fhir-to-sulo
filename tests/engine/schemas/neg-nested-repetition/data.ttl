# Two Observations, two components each. The correct answer is
#   09:15 -> {(120,mm[Hg]),(80,mm[Hg])}   and   11:40 -> {(105,mm[Hg]),(70,mm[Hg])}
# DR-301 probe 3b: the engine returns neither.
PREFIX fhir: <http://hl7.org/fhir/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>

<https://fhir.example/Patient/p-1>
    fhir:identifier "MRN-0001" ;
    fhir:observation <https://fhir.example/Observation/bp-1> ,
                     <https://fhir.example/Observation/bp-2> .

<https://fhir.example/Observation/bp-1>
    fhir:effective "2026-03-04T09:15:00Z"^^xsd:dateTime ;
    fhir:component <https://fhir.example/Observation/bp-1#c0> ,
                   <https://fhir.example/Observation/bp-1#c1> .
<https://fhir.example/Observation/bp-1#c0> fhir:value "120"^^xsd:decimal ; fhir:unit "mm[Hg]" .
<https://fhir.example/Observation/bp-1#c1> fhir:value  "80"^^xsd:decimal ; fhir:unit "mm[Hg]" .

<https://fhir.example/Observation/bp-2>
    fhir:effective "2026-03-04T11:40:00Z"^^xsd:dateTime ;
    fhir:component <https://fhir.example/Observation/bp-2#c0> ,
                   <https://fhir.example/Observation/bp-2#c1> .
<https://fhir.example/Observation/bp-2#c0> fhir:value "105"^^xsd:decimal ; fhir:unit "mm[Hg]" .
<https://fhir.example/Observation/bp-2#c1> fhir:value  "70"^^xsd:decimal ; fhir:unit "mm[Hg]" .
