    "sysResult": "{domain}bp-systolic-result-{panel}",
    "diaResult": "{domain}bp-diastolic-result-{panel}",
    "timeInstant": "{domain}time-{panel}",
    "sourceVersionIri": "{canonicalUrl}/_history/{versionId}"
  },
  "node_key_note": [
    "CD-1: host-chosen root nodes, declared in MapContract.node_key_rules, not engine-minted.",
    "Keyed by resource id, not version, so a correction replaces the same nodes."
  ],
  "passes": [
    {
      "name": "panel",
      "shape": "BPPanelRecordNode",
      "root": "panelRecord",
      "vars": [
        "recordClass",
        "timeInstant",
        "sysResult",
        "sourceVersionIri"
      ],
      "forbids_source_binding": "diaValue"
    },
    {
      "name": "panelWithDiastolic",
      "shape": "BPPanelRecordNodeWithDiastolic",
      "root": "panelRecord",
      "vars": [
