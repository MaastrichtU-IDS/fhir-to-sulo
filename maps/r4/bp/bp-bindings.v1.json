    },
    "sysQuality": {
      "source": "IdentityService.resolve_quality(person, SystolicBloodPressureQuality, LOINC 8480-6, ...)",
      "review_item": "R2"
    },
    "diaQuality": {
      "source": "IdentityService.resolve_quality(person, DiastolicBloodPressureQuality, LOINC 8462-4, ...)",
      "review_item": "R2"
    },
    "unitIri": {
      "source": "fhir_sulo.terminology.TerminologyService.resolve_unit(UCUM mm[Hg], dimension=pressure).unit.unit_iri"
