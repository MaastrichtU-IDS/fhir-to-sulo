        "timeInstant",
        "sysResult",
        "diaResult",
        "sourceVersionIri"
      ],
      "requires_source_binding": "diaValue"
    },
    {
      "name": "systolic",
      "shape": "BPSystolicQuantityNode",
      "root": "sysResult",
      "vars": [
        "sysResultClass",
        "sysValue",
        "unitIri",
        "sysQuality",
        "timeInstant",
        "sourceVersionIri"
      ]
    },
    {
      "name": "diastolic",
      "shape": "BPDiastolicQuantityNode",
      "root": "diaResult",
      "vars": [
        "diaResultClass",
        "diaValue",
        "unitIri",
        "diaQuality",
        "timeInstant",
        "sourceVersionIri"
      ],
      "requires_source_binding": "diaValue"
    },
    {
      "name": "systolicQuality",
      "shape": "BPSystolicQualityNode",
      "root": "sysQuality",
      "vars": [
        "qualityBranch",
        "sysQualityClass",
        "person"
      ]
    },
    {
      "name": "diastolicQuality",
      "shape": "BPDiastolicQualityNode",
      "root": "diaQuality",
      "vars": [
        "qualityBranch",
        "diaQualityClass",
        "person"
      ],
      "requires_source_binding": "diaValue"
    },
    {
      "name": "person",
      "shape": "BPPersonNode",
      "root": "person",
      "vars": [
        "personSuloClass",
        "personClass",
        "sysQuality"
      ],
      "forbids_source_binding": "diaValue"
    },
    {
      "name": "personWithDiastolic",
      "shape": "BPPersonNodeWithDiastolic",
      "root": "person",
      "vars": [
        "personSuloClass",
        "personClass",
        "sysQuality",
        "diaQuality"
      ],
      "requires_source_binding": "diaValue"
    },
    {
      "name": "unit",
      "shape": "BPUnitNode",
      "root": "unitIri",
      "vars": [
        "sysUnit"
      ]
    },
    {
      "name": "time",
      "shape": "BPTimeNode",
      "root": "timeInstant",
      "vars": [
        "effective"
      ]
    }
  ],
  "source_bound_vars": [
    "sysValue",
    "diaValue",
    "sysUnit",
    "diaUnit",
    "effective"
  ],
  "conditional_pass_note": [
    "`requires_source_binding` / `forbids_source_binding` is the ONLY conditional in the host path, and it is declared here rather than in code. It selects between two ALTERNATIVE ENTRY SHAPES (MapContract.allowed_alternative_shapes) for the panel record and for the person, and it runs or skips the three diastolic-only passes.",
    "A pass is skipped exactly when the source schema bound no value for the named variable -- the DR-302 rule 'one engine invocation per group', applied to a group that is absent. Nothing is reconstructed, guessed or re-associated host-side; a skipped pass emits nothing at all.",
    "Why not a single shape with an optional diastolic member: an optional target constraint whose variable is unbound emits the right graph but still reports in lastReport.unboundVariables, which would destroy the invariant that a non-empty unboundVariables is always DR-301 blocker 8c. Measured, not assumed; see the comment in bp-target.v1.shex.",
    "`bp-component-omitted` therefore yields a graph with no diastolic quantity, no diastolic quality and no diastolic member triple."
  ],
  "pass_vars_note": "tests/contracts/maps/test_bp_gate3.py asserts lastReport.unusedStatics == [] and lastReport.unboundVariables == [] on every pass, which is the CD-1 substitute for the static checker the engine does not ship. Every target constraint is required, so an unbound variable is always an error."
}
