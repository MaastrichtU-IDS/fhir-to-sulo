  "description": "The FHIR R4 element -> RDF predicate table for the pinned profile subset. Hand-authored from https://hl7.org/fhir/R4/rdf.html and verified against HL7's own published Turtle examples (observation-example-bloodpressure.ttl, observation-example-f205-egfr.ttl, encounter-example.ttl). The renderer REFUSES any element not listed here rather than dropping it, so 'no source modification is lost' is enforced by construction, not by inspection.",
  "predicate_naming_rule": "fhir:<TypeThatDefinesTheElement>.<elementName>. Elements inherited from Resource/DomainResource use the defining base type (fhir:Resource.id, fhir:DomainResource.text). BackboneElement children use the full path from the resource (fhir:Observation.component.valueQuantity).",

  "primitive_xsd": {
    "boolean": "http://www.w3.org/2001/XMLSchema#boolean",
    "integer": "http://www.w3.org/2001/XMLSchema#integer",
    "positiveInt": "http://www.w3.org/2001/XMLSchema#integer",
    "unsignedInt": "http://www.w3.org/2001/XMLSchema#integer",
    "decimal": "http://www.w3.org/2001/XMLSchema#decimal",
    "date": "#temporal",
    "dateTime": "#temporal",
    "instant": "#temporal",
    "time": "http://www.w3.org/2001/XMLSchema#time",
    "string": null,
    "code": null,
    "uri": null,
    "url": null,
    "canonical": null,
    "id": null,
    "oid": null,
    "uuid": null,
    "markdown": null,
    "base64Binary": null,
    "xhtml": null
  },
  "primitive_xsd_note": "null means a plain (untyped) literal, which is what HL7's published Turtle emits for string/code/uri. '#temporal' means the datatype is chosen from the lexical form; see temporal_precision_policy in fhir-r4-pilot.json.",

